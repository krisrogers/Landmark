{
  "expo": {
    "name": "Landmark",
    "slug": "landmark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "landmark",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kapiche.landmark",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E7D32",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Landmark uses your location to drop pins and trace areas as you walk your property."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Landmark uses the camera to photograph things you map on your property."
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
